// ── Agent v2: Hybrid Memory ────────────────────────────────────────────
// Two tables power the v2 agent's memory layer:
//   1. EpisodicMemory — one row per completed turn (user msg + assistant
//      response + tool calls summary). Stores a 384-dim embedding (base64
//      Float32Array) of the user's message for cosine-similarity recall.
//   2. ConversationSummary — rolling LLM-generated summary of the last N
//      turns, refreshed every few turns. Cheap to fetch and inject into the
//      system prompt so the agent has long-term context without re-reading
//      the entire transcript.
// Both are per-user; guests get nothing persisted (memory is keyed on userId).

model EpisodicMemory {
  id          String   @id @default(cuid())
  userId      String
  // The user's message verbatim (truncated to 2000 chars at write time)
  userMessage String
  // The agent's final text response (truncated to 4000 chars)
  agentResponse String
  // JSON array of { toolName, args } for tools called during this turn
  toolCalls   String   @default("[]")
  // Free-text tags extracted from the message (e.g. ["cardiology", "study-plan"])
  tags        String   @default("[]")
  // 384-dim embedding serialized as base64 Float32Array, or "" if unavailable
  embedding   String   @default("")
  // Cosine-similarity pre-computed cluster id (reserved for future use)
  clusterId   Int?
  // The currentTab the user was on when they sent the message
  currentTab  String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, clusterId])
}

model ConversationSummary {
  id          String   @id @default(cuid())
  userId      String
  // The rolling summary text (typically 200-500 words)
  summary     String
  // How many turns were covered by this summary
  turnCount   Int      @default(0)
  // The timestamp of the LAST turn covered by this summary
  lastTurnAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastTurnAt])
}


