generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}


datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  MANAGER
  ADMIN
}


// ── Authentication & User System ──

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // hashed with bcryptjs
  image         String?
  bio           String?   @default("")
  role          String    @default("student") // student, educator, admin
  medicalSchool String?   @default("")
  graduationYear Int?
  specialty     String?   @default("")
  country       String?   @default("")
  onboardingCompleted Boolean @default(false)
  lastActiveAt  DateTime? @default(now())
  isOnline      Boolean   @default(false)
  // ── Per-user default AI model ──
  // Model string in "providerId:modelId" format (e.g. "openai:gpt-4o", "ollama:llama3.3").
  // When null, falls back to DEFAULT_MODEL env var → auto-detect (Ollama → env keys → ZAI).
  // Set via the ModelPicker UI. See /api/user/default-model.
  defaultModel  String?
  // ── Admin moderation fields ──
  // status: "active" | "suspended" | "banned"
  // - active: normal account
  // - suspended: temporary lock, reinstated automatically when suspendedUntil passes
  // - banned: permanent lock, requires admin action to lift
  status          String    @default("active")
  suspendedUntil  DateTime?
  suspendedReason String?
  bannedAt        DateTime?
  bannedReason    String?
  passwordResetAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  subscription   Subscription?
  creditWallet   CreditWallet?
  usageRecords   UsageRecord[]
  paymentOrders  PaymentOrder[]
  bookmarks      Bookmark[]
  notes          QuestionNote[]
  studySessions  StudySession[]
  streaks        StudyStreak[]
  achievements   UserAchievement[]
  flashcardProgress FlashcardProgress[]
  tutorMessages  TutorMessage[]
  collections    Collection[]
  examAttempts   ExamAttempt[]
  questionAttempts QuestionAttempt[]
  dailyChallenges DailyChallengeAttempt[]
  studyPlans     StudyPlan[]
  caseAttempts   CaseAttempt[]
  boardPrepProfiles BoardPrepProfile[]
  adImpressions  AdImpression[]
  adRewards      AdReward[]
  sentFriendRequests     Friendship[]   @relation("SentRequests")
  receivedFriendRequests Friendship[]   @relation("ReceivedRequests")
  blockedUsers           BlockedUser[]  @relation("BlockedUsers")
  blockedBy              BlockedUser[]  @relation("BlockedBy")
  challengeChallenger    UserChallenge[] @relation("Challenger")
  challengeChallenged    UserChallenge[] @relation("Challenged")
  chatRoomMembers        ChatRoomMember[]
  chatMessages           ChatMessage[]
  groupMemberships       GroupMember[]
  posts                  Post[]
  comments               Comment[]
  postLikes              PostLike[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  osceSessions           OsceSession[]
  discussions            QuestionDiscussion[]
  questionReports        QuestionReport[]
  qotdAttempts           QOTDAttempt[]
  speedQuizSessions      SpeedQuizSession[]
  vignetteAttempts       VignetteAttempt[]
  quickNotes             QuickNote[]
  guidelineBookmarks     GuidelineBookmark[]
  procedureProgress      ProcedureProgress[]
  procedureNotes         ProcedureNote[]
  procedureBookmarks     ProcedureBookmark[]
  cmeCredits             CMECredit[]
  apiKeys                UserApiKey[]
  groupLectures          GroupLecture[]
  groupQuestions         GroupQuestion[]
  groupQuizAttempts      GroupQuizAttempt[]
  groupAdPolls           GroupAdPoll[]
  groupAdPollVotes       GroupAdPollVote[]
  groupAdRevenueShares   GroupAdRevenueShare[]
  groupLectureProgress   GroupLectureProgress[]
  groupQuestionBookmarks GroupQuestionBookmark[]
  groupQuestionComments  GroupQuestionComment[]
  groupAdPollComments    GroupAdPollComment[]
  groupFlashcardDecks    GroupFlashcardDeck[]
  groupFlashcards        GroupFlashcard[]
  groupFlashcardReviews  GroupFlashcardReview[]
  // Agent v2 hybrid memory
  episodicMemories       EpisodicMemory[]
  conversationSummaries  ConversationSummary[]
  // Mock-backend wiring: trivia + ECG attempts
  triviaAttempts         TriviaAttempt[]
  ecgAttempts            EcgAttempt[]
  flashcardArenaResults  FlashcardArenaResult[]
  // Whiteboard Studio — saved drawings/canvases
  whiteboardDocuments    WhiteboardDocument[]
  // Admin audit log entries authored by this user (admin actions)
  auditLogs              AuditLog[]
  // ── Security: device fingerprints + security events ──
  // Each login records a DeviceFingerprint; anomalous activity writes
  // to SecurityEvent. See src/lib/security/* and Settings → Security.
  deviceFingerprints     DeviceFingerprint[]
  securityEvents         SecurityEvent[]
  // Realtime voice-to-voice keys (OpenAI Realtime / Gemini Live)
  realtimeVoiceKeys      RealtimeVoiceKey[]
}

// ── BYOK (Bring Your Own Key) — app-wide, server-side encrypted ──
// User-supplied AI provider API keys. Stored AES-256-GCM encrypted server-side
// (see src/lib/server/byok-crypto.ts) so they:
//   - Sync across the user's devices (server-side storage, NOT localStorage).
//   - Never appear in the browser's localStorage/IndexedDB (XSS-safe).
//   - Are scoped per user (one key per provider per user).
// Resolution priority at AI request time (see src/lib/server/resolve-model.ts):
//   1. Server-managed provider (operator's key in env/YAML) — wins.
//   2. Client-sent key (x-api-key header) — legacy classroom BYOK.
//   3. User-saved BYOK key (this table) — syncs across devices.
//   4. Nothing → 401/error.
model UserApiKey {
  id             String   @id @default(cuid())
  userId         String
  // Provider identifier matching `PROVIDERS` in src/lib/ai/providers.ts
  // (e.g. "openai", "anthropic", "google", "glm", "deepseek", "qwen", …).
  providerId     String
  // AES-256-GCM ciphertext (base64). Plaintext key NEVER stored.
  encryptedKey   String
  // GCM initialization vector (base64, 12 bytes).
  iv             String
  // GCM auth tag (base64, 16 bytes).
  authTag        String
  // Optional per-provider override (e.g. for OpenAI-compatible proxies).
  baseUrl        String?
  // Optional user-facing label ("Work key", "Personal key"…).
  label          String?
  // JSON-encoded per-provider model catalog overrides. Shape:
  //   Array<{ id: string; name: string;
  //           capabilities?: { vision?: boolean; tools?: boolean; streaming?: boolean };
  //           contextWindow?: number; outputWindow?: number }>
  // When null/empty, the UI falls back to auto-discovered models from /models.
  // Stored as a JSON string because SQLite has no native JSON column type.
  modelsConfig   String?
  // Soft toggle so users can keep a key on file without using it.
  enabled        Boolean  @default(true)
  // ── Multi-endpoint BYOK ──
  // A user may save SEVERAL endpoints for the SAME provider (e.g. an
  // OpenAI key plus a corporate-gateway key, or a remote Ollama plus a
  // local Ollama). Each row is one endpoint = (key?, baseUrl?, label,
  // enabled, priority). The resolver picks one endpoint per request
  // (round-robin across enabled rows ordered by priority) and callChat
  // fails over to the next endpoint when one fails. Lower priority
  // value = tried first.
  priority       Int      @default(0)
  lastUsedAt     DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOTE: the old @@unique([userId, providerId]) was REMOVED so multiple
  // endpoints per provider can coexist. Rows are addressed by row `id`.
  @@index([userId, providerId])
  @@index([userId])
}

// Retained legacy credentials from the retired realtime voice-call feature.
// The app no longer reads or writes these rows; keep the model to avoid
// dropping user data as part of the call-provider migration.
model RealtimeVoiceKey {
  id         String   @id @default(cuid())
  userId     String
  // 'openai' | 'google'
  provider   String
  // AES-256-GCM ciphertext (base64). Plaintext key NEVER stored.
  ciphertext String
  // GCM initialization vector (base64, 12 bytes).
  iv         String
  // GCM auth tag (base64, 16 bytes).
  authTag    String
  // Optional user-facing label ("Work key"…).
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Questions & Exams ──

model Question {
  id                     String   @id @default(cuid())
  type                   String   @default("mcq")     // mcq, tf, short
  text                   String   @default("")
  options                String   @default("[]")       // JSON array of strings
  answer                 String   @default("")
  explanation            String   @default("")
  mnemonic               String   @default("")
  clinicalPearl          String   @default("")
  distractorAnalysis     String   @default("")
  difficulty             String   @default("Moderate")   // Easy(1), Basic(2), Moderate(3), Hard(4), Expert(5) — legacy: Medium→Moderate
  system                 String   @default("")
  topic                  String   @default("")
  tags                   String   @default("[]")       // JSON array of strings
  isAIGenerated          Boolean  @default(false)
  illustrationDescription String  @default("")        // AI-generated description of what the illustration should show
  organInvolvement       String  @default("")        // HTML: organs/structures involved with roles
  mechanismDiagram       String  @default("")        // HTML: mechanism of action flow diagram
  visualSummary          String  @default("")        // HTML: compact visual summary card
  diagramSpec            String  @default("")        // JSON: DiagramRenderer spec for interactive pathway diagrams
  molecularScenes        String  @default("")        // JSON: MolecularIllustrator spec for molecular mechanism scenes
  sources                String  @default("[]")      // JSON: array of {type, title} for source citations
  imageUrl               String   @default("")
  audioUrl               String   @default("")
  videoUrl               String   @default("")
  modelUrl               String   @default("")     // 3D model embed URL (e.g. Sketchfab) — "explore the model" questions
  videoTaskId            String   @default("")
  // ── Stage 3: timestamped video citation (mediaTimeSec deep-link) ──
  videoSourceId          String   @default("")   // KnowledgeSource id of the cited video
  videoSceneStart        Float    @default(0)    // cited scene span start (seconds)
  videoSceneEnd          Float    @default(0)    // cited scene span end (seconds)
  // ── Enhanced media metadata (agent pipeline) ──
  labPanel               String   @default("[]")    // JSON: [{name, rows:[{test, value, unit, flag}]}] — rendered as styled table
  pcgSpec                String   @default("")     // JSON: {phase, shape} phonocardiogram spec synced to the audio player
  hotspots               String   @default("[]")    // JSON: [{label, x, y}] percentage pins on the image — clicking selects the option
  structureTags          String   @default("[]")    // JSON: [{letter, name}] clickable structure chips beside the 3D model
  // ── USMLE-style blueprint tagging ──
  blueprintOrgan         String   @default("")     // organ system (Cardiovascular, Respiratory...)
  blueprintTask          String   @default("")     // task/competency (Diagnosis, Mechanism, Management...)
  // ── RAG provenance: which knowledge-library sources grounded this question ──
  knowledgeSourceIds     String   @default("[]")   // JSON array of KnowledgeSource ids used for grounding
  // ── Advanced citations: chunk-level provenance for "highlight in the source" ──
  // JSON array of {sourceId, chunkId, documentId, title, fileKind, quote} —
  // each entry links the question to the EXACT passage that grounded it, so
  // the UI can open the source viewer scrolled to + highlighting that passage.
  citations              String   @default("[]")
  // ── Medical accuracy review pass ──
  reviewStatus           String   @default("pending") // pending | approved | flagged
  reviewNotes            String   @default("")     // JSON: reviewer verdict details
  // ── Adaptive difficulty calibration (computed from real attempts) ──
  difficultyP            Float    @default(-1)     // p-value: proportion of users answering correctly (-1 = uncalibrated)
  discrimination         Float    @default(-1)     // point-biserial discrimination (-1 = uncalibrated)
  attemptsCount          Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  examQuestions          ExamQuestion[]
  bookmarks              Bookmark[]
  notes                  QuestionNote[]
  flashcardProgress      FlashcardProgress[]
  collectionItems        CollectionItem[]
  discussions            QuestionDiscussion[]
  reports                QuestionReport[]
  questionAttempts       QuestionAttempt[]

  @@index([system])
  @@index([difficulty])
  @@index([createdAt])
  @@index([system, difficulty])
  @@index([blueprintOrgan])
  @@index([reviewStatus])
}

model Exam {
  id          String   @id @default(cuid())
  title       String   @default("")
  description String   @default("")
  duration    Int      @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id         String  @id @default(cuid())
  examId     String
  questionId String
  order      Int     @default(0)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
}

model ExamAttempt {
  id             String   @id @default(cuid())
  userId         String
  examId         String
  score          Int      @default(0)
  totalQuestions Int      @default(0)
  answers        String   @default("{}")  // JSON object
  completedAt    DateTime @default(now())

  exam  Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([examId])
}

model MediaSearchCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique // "<kind>:<normalized query>"
  kind        String   @default("sound") // sound | model | image | video
  resultJson  String   @default("null") // JSON of the found asset (or null = known-miss)
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime

  @@index([kind])
  @@index([expiresAt])
}

model QuestionAttempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  selectedAnswer String   @default("")
  isCorrect      Boolean  @default(false)
  confidence     String   @default("")   // sure | probably | guessing
  timeSpent      Int      @default(0)   // seconds
  mode           String   @default("bank") // bank | exam | review | weakness | smart
  createdAt      DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([userId, isCorrect])
  @@index([mode])
}

model Content {
  id          String   @id @default(cuid())
  title       String   @default("")
  topic       String   @default("")
  type        String   @default("story")   // story, article, poem, quote, presentation, question
  tone        String   @default("inspirational") // inspirational, educational, dramatic, humorous, reflective
  body        String   @default("")
  summary     String   @default("")
  metadata    String   @default("{}")      // JSON: question-specific data
  imageUrl    String   @default("")
  videoUrl    String   @default("")
  audioUrl    String   @default("")
  videoTaskId String   @default("")
  hasImage    Boolean  @default(false)
  hasVideo    Boolean  @default(false)
  hasAudio    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model QuestionNote {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model StudySession {
  id           String   @id @default(cuid())
  userId       String
  type         String   @default("flashcard") // flashcard, exam, quiz, bank-review, tutor
  questionsStudied Int  @default(0)
  correctAnswers  Int  @default(0)
  totalTimeSpent  Int  @default(0) // seconds
  metadata     String   @default("{}") // JSON: additional data
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StudyStreak {
  id          String   @id @default(cuid())
  userId      String
  date        String   @default("") // YYYY-MM-DD
  questionsStudied Int @default(0)
  timeSpent   Int      @default(0) // seconds
  xpEarned    Int      @default(0)
  streakFreezes Int    @default(0) // number of streak freezes available
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Achievement {
  id          String   @id @default(cuid())
  type        String   @default("") // first_question, streak_7, streak_30, quiz_master, etc.
  title       String   @default("")
  description String   @default("")
  icon        String   @default("") // emoji or icon name

  userAchievements UserAchievement[]

  @@unique([type])
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  achievementType String
  unlockedAt  DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementType], references: [type], onDelete: Cascade)

  @@unique([userId, achievementType])
}

model FlashcardProgress {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  interval        Int      @default(1)  // days until next review
  repetition      Int      @default(0)  // number of successful reviews
  efactor         Float    @default(2.5) // easiness factor (SM-2 algorithm)
  nextReview      DateTime @default(now())
  lastReview      DateTime @default(now())
  // ── FSRS-5 state (upgraded scheduler; legacy SM-2 fields kept for compat) ──
  stability       Float    @default(0)  // FSRS memory stability (days)
  fsrsDifficulty  Float    @default(5)  // FSRS difficulty (1-10)
  reps            Int      @default(0)  // FSRS total repetitions
  lapses          Int      @default(0)  // FSRS lapses (forgot count)
  lastRating      Int      @default(0)  // last rating 1-4 (again/hard/good/easy)
  state           Int      @default(0)  // 0 new, 1 learning, 2 review, 3 relearning
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model TutorMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   @default("user") // user, assistant
  content   String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("")
  description String   @default("")
  color       String   @default("#00e5a0") // accent color
  icon        String   @default("📚") // emoji icon
  isPublic    Boolean  @default(false)
  shareCode   String   @default("") // unique share code for public collections
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CollectionItem[]
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  questionId   String
  order        Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, questionId])
}

model DailyChallenge {
  id              String   @id @default(cuid())
  date            String   @default("") // YYYY-MM-DD
  questionIds     String   @default("[]") // JSON array of question IDs
  theme           String   @default("") // e.g. "Cardiovascular", "Pharmacology"
  difficulty      String   @default("Mixed")
  totalQuestions  Int      @default(5)
  createdAt       DateTime @default(now())

  @@unique([date])
}

model DailyChallengeAttempt {
  id           String   @id @default(cuid())
  userId       String
  challengeDate String  @default("") // YYYY-MM-DD
  score        Int      @default(0)
  totalQuestions Int    @default(0)
  answers      String   @default("{}") // JSON
  timeSpent    Int      @default(0) // seconds
  completedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeDate])
}

// ── Study Planner ──

model StudyPlan {
  id              String   @id @default(cuid())
  userId          String
  name            String   @default("")
  examDate        DateTime
  examType        String   @default("") // "final", "usmle_step1", "usmle_step2", "plab", "custom"
  hoursPerDay     Float    @default(2.0)
  daysPerWeek     Int      @default(5)
  topics          String   @default("[]")  // JSON: array of system/topic strings
  status          String   @default("active") // active, completed, abandoned
  adherenceScore  Float    @default(0)     // 0-100
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dailyBlocks     PlanDailyBlock[]
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanDailyBlock {
  id          String   @id @default(cuid())
  planId      String
  date        String   @default("") // YYYY-MM-DD
  tasks       String   @default("[]")  // JSON: array of PlanTask objects
  completedAt DateTime?

  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, date])
}

// ── Clinical Case Simulator ──

model ClinicalCase {
  id            String   @id @default(cuid())
  title         String   @default("")
  system        String   @default("")
  topic         String   @default("")
  difficulty    String   @default("Medium")
  caseType      String   @default("diagnostic") // diagnostic, management, emergency
  patientInfo   String   @default("{}")  // JSON: { age, sex, chiefComplaint, presentingHistory }
  stages        String   @default("[]")  // JSON: array of CaseStage objects
  isAIGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts      CaseAttempt[]
}

model CaseAttempt {
  id          String   @id @default(cuid())
  userId      String
  caseId      String
  decisions   String   @default("[]")  // JSON: array of { stageId, selectedOption, correct, timestamp }
  score       Int      @default(0)     // 0-100
  completedAt DateTime @default(now())

  case        ClinicalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([caseId])
}

// ── Knowledge Map ──

model ConceptNode {
  id          String   @id @default(cuid())
  name        String
  system      String
  type        String   @default("disease") // disease, drug, procedure, anatomy, finding
  description String   @default("")
  aliases     String   @default("[]") // JSON: alternate names
  createdAt   DateTime @default(now())

  fromEdges   ConceptEdge[] @relation("FromConcept")
  toEdges     ConceptEdge[] @relation("ToConcept")
}

model ConceptEdge {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  relationship String   // "causes", "treats", "diagnoses", "complicates", "differential", "risk_factor"
  strength     Int      @default(1) // 1-5
  description  String   @default("")

  fromConcept  ConceptNode @relation("FromConcept", fields: [fromId], references: [id], onDelete: Cascade)
  toConcept    ConceptNode @relation("ToConcept", fields: [toId], references: [id], onDelete: Cascade)
}

