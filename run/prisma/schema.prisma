  quiz          String   @default("[]")   // JSON: array of ProcedureQuiz objects
  difficulty    String   @default("Intermediate") // Beginner, Intermediate, Advanced
  tags          String   @default("[]")   // JSON: array of tag strings
  isBuiltin     Boolean  @default(true)   // built-in vs user-added
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookmarks     ProcedureBookmark[]
  progress      ProcedureProgress[]
