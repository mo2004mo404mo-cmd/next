  groupId     String?            // null = public post on personal feed
  content     String   @default("")
  imageUrl    String   @default("")
  type        String   @default("text") // text, image, achievement, challenge_result, study_milestone
  metadata    String   @default("{}")   // JSON: { challengeId, score, achievementType, etc. }
  likesCount  Int      @default(0)
  commentsCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

