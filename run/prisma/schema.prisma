  group    Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    PostLike[]

  @@index([groupId, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// ── Notifications ──

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("") // friend_request, challenge, group_invite, post_like, post_comment, mention, achievement, system
  title       String   @default("")
  message     String   @default("")
  fromUserId  String?
  referenceId String   @default("") // ID of related entity (friendship, challenge, post, etc.)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

// ── Web Push subscriptions ──
// One user can have multiple subscriptions (one per device/browser).
// Endpoint is the unique key — FCM/Mozilla push endpoints are stable per
// (browser, user) pair. We use it to dedupe and to unsubscribe.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique // GCM/FCM/Mozilla push endpoint URL
  p256dh    String   // base64url-encoded ECDH P-256 public key
  auth      String   // base64url-encoded auth secret
  userAgent String?  // browser/device identifier for the user to manage subscriptions
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

