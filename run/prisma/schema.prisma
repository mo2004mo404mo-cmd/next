// ── Group Study: Lectures with chunks, categorized questions, self-test ──

model GroupLecture {
  id          String   @id @default(cuid())
  groupId     String
  authorId    String
  title       String   @default("")
  description String   @default("")
  system      String   @default("")     // e.g. "Cardiology"
  topic       String   @default("")     // e.g. "Heart Failure"
  coverUrl    String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group    Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chunks   GroupLectureChunk[]
  questions GroupQuestion[]
  progress GroupLectureProgress[]

  @@index([groupId])
  @@index([authorId])
}

model GroupLectureChunk {
  id          String   @id @default(cuid())
  lectureId   String
  title       String   @default("")     // section/title within the lecture
  sourceTitle String   @default("")     // per-source label (e.g. "Short Intro", "Deep Dive")
  sourceDescription String @default("") // per-source description / notes
  type        String   @default("video") // video, pdf, image, text, link
  url         String   @default("")      // media URL
  textContent String   @default("")      // for text chunks
  duration    Int      @default(0)       // seconds (video/audio)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── Section-level metadata ───
  // Sections are implicit (chunks grouped by `title`). These fields live on
  // the chunk but represent SECTION-level attributes — they're shared across
  // all alternative sources of the same section (i.e. all chunks with the
  // same `title` within a lecture). When rendering, we read them from the
  // FIRST chunk of each section; when saving, we write them to ALL chunks
  // in the section so they stay in sync regardless of which source the
  // student picks.
  sectionDescription String @default("") // what this section covers (shown above the content)
  sectionObjectives  String @default("") // JSON array of learning objective strings (e.g. ["Understand X", "Apply Y"])
  sectionTags        String @default("") // JSON array of tag strings (e.g. ["high-yield", "exam"])
  estimatedMinutes   Int    @default(0)  // admin's estimate of how long the section takes (0 = unknown)

  lecture  GroupLecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

// GroupCourseMeta — per-course (subject) metadata within a group.
// Courses/subjects are implicit (derived from GroupLecture.system field),
// but we need a place to store course-level cover images and descriptions
// without a full Subject model migration. One row per (groupId, subject)
// pair. Created on-demand when an admin sets a cover or description.
model GroupCourseMeta {
  id          String   @id @default(cuid())
  groupId     String
  subject     String   // matches GroupLecture.system — the course/subject name
  coverUrl    String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, subject])
  @@index([groupId])
}

// Group questions categorised by source
model GroupQuestion {
  id          String   @id @default(cuid())
  groupId     String
  lectureId   String?                  // optional link to a lecture
  authorId    String                   // who added it (doctor/educator/admin)
  category    String   @default("lecture") // previous_exam, lecture, doctor, high_yield
  type        String   @default("mcq")     // mcq, tf, short
  text        String   @default("")
  options     String   @default("[]")      // JSON array of strings
  answer      String   @default("")
  explanation String   @default("")
  difficulty  String   @default("Moderate")
  system      String   @default("")
  topic       String   @default("")
  tags        String   @default("[]")      // JSON array
