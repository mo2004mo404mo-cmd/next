// ── Video Lectures ──

model Lecture {
  id          String   @id @default(cuid())
  title       String   @default("")
  system      String   @default("")
  topic       String   @default("")
  slides      String   @default("[]")  // JSON
  slideCount  Int      @default(0)
  duration    Int      @default(0)
  status      String   @default("generating") // generating, ready, failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Freemium & Subscription System ──

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  tier                   String   @default("free")  // free, premium, pro
  status                 String   @default("active") // active, past_due, cancelled, expired
  currentPeriodEnd       DateTime @default(now())
  // ── Stripe billing linkage ──
  // Empty when subscription was set manually (admin grant, mock checkout, or
  // the operator hasn't configured STRIPE_SECRET_KEY). Populated when the
  // upgrade flowed through Stripe Checkout + Webhook.
  stripeCustomerId       String   @default("")
  stripeSubscriptionId   String   @default("")
  stripePriceId          String   @default("")
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Payment Orders ──
// One row per checkout attempt (subscription upgrade OR credit package
// purchase). Tracks the lifecycle: pending → paid → (refunded). The
// `kind` field discriminates between the two flows so the webhook can
// route to the correct fulfillment logic.
model PaymentOrder {
  id                      String    @id @default(cuid())
  userId                  String
  // "subscription" | "credits"
  kind                    String    @default("")
  // For kind=subscription: tier id ("premium"|"pro"). For kind=credits: package id.
  referenceId             String    @default("")
  amountUsd               Float     @default(0.0)
  // Number of credits granted when this order is paid (0 for subscription orders
  // unless the tier grants a monthly credit allowance — handled separately).
  credits                 Int       @default(0)
  // "pending" | "paid" | "failed" | "refunded"
  status                  String    @default("pending")
  stripeCheckoutSessionId String    @default("")
  stripePaymentIntentId   String    @default("")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  paidAt                  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  date      String   @default("") // YYYY-MM-DD
  category  String   @default("") // ai_generations, tutor_messages, video_lessons, etc.
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, category])
}

// ── AI call telemetry (BYOK Analytics) ──
// One row per completed callChat()/streamChat() attempt that reached the LLM
// (success OR error). Powers the Settings → AI Providers → Analytics tab:
// stat cards (requests, success rate, tokens, latency), by-provider /
// by-model breakdowns, and the recent-calls table. Written fire-and-forget
// from src/lib/server/ai-call-log.ts — never on the request critical path
// and never allowed to throw into the caller.
model AiCallLog {
  id            String   @id @default(cuid())
  userId        String?
  providerId    String   // "openai", "ollama", "zai", …
  modelId       String   // "gpt-4o", "zai-llm", …
  stage         String?  // explain | chat | tutor | generate | import-extend …
  status        String   // "success" | "error"
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  latencyMs     Int?
  error         String?  // first 500 chars of the error message
  endpointRowId String?  // UserApiKey row used (BYOK attribution)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([createdAt])
}

