// ─────────────────────────────────────────────────────────────────────────
// Security: Device Fingerprint
// ─────────────────────────────────────────────────────────────────────────
// One row per (user, device) pair. The `fingerprintHash` is a stable
// SHA-256 of client-collected signals (canvas, webgl, audio, fonts, UA,
// timezone, screen, etc.). See src/lib/security/fingerprint-client.ts.
//
// On each login, the client sends its fingerprint; the server:
//   1. Looks up (userId, fingerprintHash).
//   2. If found and not revoked → trusted login, update lastSeenAt + ip.
//   3. If found and revoked → block (or step-up challenge — TODO).
//   4. If not found → record as new device, emit SecurityEvent "device.new".
//
// `label` is an optional user-supplied name ("My iPhone", "Library Mac").
// `trustScore` is 0-100; starts at 50 for new devices, climbs with
// successful logins, drops on anomalies.

model DeviceFingerprint {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String   // SHA-256 hex, 64 chars
  label           String?  // user-supplied device name
  // Stable components stored for diffing / display (never the raw signals):
  userAgent       String   @default("")
  platform        String   @default("")  // "Win32", "MacIntel", "iPhone", "Linux x86_64"
  osGuess         String   @default("")  // "Windows", "macOS", "iOS", "Android", "Linux"
  browserGuess    String   @default("")  // "Chrome", "Firefox", "Safari", "Edge"
  screenSummary   String   @default("")  // "1920x1080x2" — width x height x dpr
  timezone        String   @default("")  // IANA tz, e.g. "Africa/Cairo"
  trustScore      Int      @default(50)  // 0-100
  revoked         Boolean  @default(false)
  revokedAt       DateTime?
  revokedReason   String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  lastIp          String   @default("")
  lastGeo         String   @default("")  // "city, country" best-effort from IP
  loginCount      Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
  @@index([fingerprintHash])
}

// ─────────────────────────────────────────────────────────────────────────
// Security: SecurityEvent
// ─────────────────────────────────────────────────────────────────────────
// Append-only log of security-relevant events for a user:
//   - login.success / login.failed
//   - device.new / device.revoked / device.trust_changed
//   - password.changed / password.reset_requested
//   - location.anomaly (geo mismatch vs. usual IPs)
//   - rate_limited / csrf_blocked
//   - session.revoked
//
// `severity` is "info" | "warn" | "critical". `metadata` is a JSON string
// for arbitrary per-event fields (ip, ua, fingerprint, geo, etc.).

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String
  eventType   String   // see comment above
  severity    String   @default("info") // info | warn | critical
  message     String   @default("")
  metadata    String   @default("{}")   // JSON
  ipAddress   String   @default("")
  userAgent   String   @default("")
  fingerprintHash String @default("")   // optional, links to DeviceFingerprint
  readAt      DateTime?                  // null = unread
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([severity, createdAt])
}


// ─────────────────────────────────────────────────────────────────────────
// Rate Limiting (token bucket per key)
// ─────────────────────────────────────────────────────────────────────────
// Used by src/lib/security/rate-limit.ts as a persistent fallback when the
// in-memory LRU cache is empty (e.g. after a server restart, or on a
// multi-instance deploy where the in-memory cache isn't shared).
//
// For dev / single-instance, the in-memory cache handles 99% of requests;
// this table is the source of truth for the rolling count window.

model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String   @unique // e.g. "login:1.2.3.4" or "api:userId:endpoint"
  tokens      Float    @default(0)
  lastRefill  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bucketKey, updatedAt])
}



// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Skills (ported from reference deep-agent platforms)
// ─────────────────────────────────────────────────────────────────────────
// DB source of truth for agent skills. Builtin skills (source="builtin") are
// seeded from src/lib/agent/skills/builtin-skills.ts; user skills are created
// through /api/medq-agent/skills. At agent-build time enabled skills are
// synced to SKILL.md packs inside the per-user agent workspace, where the
// deepagents skills middleware loads them with progressive disclosure (only
// name + description enter the system prompt; the body is read on demand).

model AgentSkill {
  id             String   @id @default(cuid())
  userId         String?
  name           String   // kebab-case, unique per user
  description    String
  content        String   // markdown body (without frontmatter)
  suggestedTools String?  // JSON array of tool names the skill steers toward (deep-agent parity)
  enabled        Boolean  @default(true)
  source         String   @default("user") // builtin | user | imported | ai
  category       String   @default("Study")
  lastEditedBy   String   @default("user") // user | agent — who wrote the CURRENT version
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  revisions      AgentSkillRevision[]

  @@unique([userId, name])
  @@index([userId, enabled])
}

// ─────────────────────────────────────────────────────────────────────────
// AgentSkillRevision — version history for the self-improving skill loop.
// Every content change (agent improvement, user edit, restore) snapshots the
// PRIOR version first, so any rewrite is reversible from the skills viewer.
// ─────────────────────────────────────────────────────────────────────────
model AgentSkillRevision {
  id          String      @id @default(cuid())
  skillId     String
  skill       AgentSkill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  name        String      // skill name at snapshot time (survives renames)
  description String
  content     String
  reason      String?     // why the change happened (agent findings / user note / restore)
  editedBy    String      @default("system") // agent | user | system (restore/import bookkeeping)
  createdAt   DateTime    @default(now())

  @@index([skillId, createdAt])
}


// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Long-term memory (layered, per user/guest)
// ─────────────────────────────────────────────────────────────────────────
// Layers: profile (who the learner is), study (learning habits & progress
// facts), fact (knowledge learned during interactions). Injected into the
// agent system prompt each run via buildMemoryContext() and searchable by
// the save_memory / search_memory agent tools.

model AgentMemory {
  id         String   @id @default(cuid())
  userId     String
  scope      String   // profile | study | fact | conversation | semantic (auto-extracted)
  key        String?
  content    String
  importance Float    @default(0.5)
  embedding  Bytes?   // 256-d vector (local hashed-trigram or remote embedder) for semantic recall
  threadId   String?  // conversation-scope working memory (hermes parity)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, scope])
  @@index([userId, updatedAt])
  @@index([threadId])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Knowledge base / RAG (deep-agent-platform parity,
// compare-and-integrate-4). Per-user corpus: KnowledgeSource (file | url |
// text) → KnowledgeDocument (parsed text) → KnowledgeChunk (embedded
// segment). Retrieval does a cosine scan over chunk embeddings and renders
// [K#]-cited context for the system prompt + search_knowledge tool.
// ─────────────────────────────────────────────────────────────────────────

model KnowledgeSource {
  id          String              @id @default(cuid())
  userId      String
  name        String
  type        String              // file | url | text
  status      String              @default("pending") // pending | processing | ready | failed
  error       String?
  metaJson    String?             // { title, chunks, mimeType, sizeBytes, fileKind, durationSec, transcription }
  // file content origin: document (pdf/docx/txt) | audio | video | image | url | text
  fileKind    String              @default("document")
  documents   KnowledgeDocument[]
  chunks      KnowledgeChunk[]
  scenes      VideoScene[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId, status])
}

model KnowledgeDocument {
  id         String           @id @default(cuid())
  sourceId   String
  source     KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title      String
  mimeType   String           @default("text/plain")
  sizeBytes  Int              @default(0)
  content    String?          // original parsed text (truncated at 100k chars)
  chunkCount Int              @default(0)
  chunks     KnowledgeChunk[]
  createdAt  DateTime         @default(now())

  @@index([sourceId])
}

model KnowledgeChunk {
  id              String            @id @default(cuid())
  documentId      String
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceId        String
  source          KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idx             Int
  content         String
  embedding       Bytes?            // serialized Float32Array (model-dependent dim)
  // Which embedder produced `embedding` (e.g. "openai-compatible:.../text-embedding-3-small"
  // or "local-hash"). Retrieval only compares chunks whose model matches the
  // active provider — prevents cross-model dimension/space mismatches.
  embeddingModel  String            @default("")
  // Contextual retrieval (Anthropic-style): a 1-2 sentence LLM-written blurb
  // describing what this chunk contains and where it sits in the document.
  // Prepended to the content before embedding AND included in BM25 lexical
  // scoring — this is the single biggest retrieval-accuracy upgrade.
  contextSummary  String            @default("")
  tokens          Int               @default(0)
  metaJson        String?           // { title, timestamp }
  createdAt       DateTime          @default(now())

  @@index([sourceId])
  @@index([documentId])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Video scene index (Stage 3 temporal RAG). One row per scene
// (ffmpeg scene-cut boundary, or an even time window when no cuts fire):
// VLM description of the representative frame + the [mm:ss]-stamped ASR
// segments inside the span + an embedding of both. Powers search_video_scenes
// and timestamp-deep-linked question citations (mediaTimeSec).
// ─────────────────────────────────────────────────────────────────────────

model VideoScene {
  id             String   @id @default(cuid())
  sourceId       String
  source         KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sceneIdx       Int
  startSec       Float
  endSec         Float
  detection      String   @default("scene-cut") // scene-cut | even-window
  description    String   @default("")          // VLM description of the representative frame
  transcript     String   @default("")          // ASR segments within the span
  embedding      Bytes?
  embeddingModel String   @default("")
  createdAt      DateTime @default(now())

  @@index([sourceId, sceneIdx])
  @@index([sourceId, startSec])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — RAG query observability. One row per hybrid retrieval call:
// the expanded queries, per-stage rankings and the final fused list. Powers
// retrieval debugging ("why didn't chunk X surface?") and accuracy tuning.
// ─────────────────────────────────────────────────────────────────────────

model RagQueryLog {
  id           String   @id @default(cuid())
  userId       String
  query        String
  sourceIds    String   @default("[]") // JSON array of knowledge source ids (scope filter)
  queriesJson  String   @default("[]") // JSON array of expanded/reformulated queries
  retrievedJson String  @default("[]") // JSON array of {chunkId, documentId, sourceId, score, stages}
  topK         Int      @default(8)
  latencyMs    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Tool execution telemetry (deep-agent-platform parity).
// One best-effort row per builtin tool invocation: status, latency, capped
// input/output snapshots. Powers the Usage tab's tool-stats rollup and
// debugging (“which tool is slow / failing?”).
// ─────────────────────────────────────────────────────────────────────────

model AgentToolExecution {
  id         String   @id @default(cuid())
  userId     String
  threadId   String?
  toolName   String
  status     String   // running | completed | failed
  latencyMs  Int?
  inputJson  String?  // capped args snapshot
  outputJson String?  // capped output snapshot
  error      String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([toolName])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Run telemetry (hermes Run parity, compare-and-integrate-3)
// One row per agent turn (chat / job / webhook / resume) for the usage
// dashboard's run-health rollup and the /api/medq-agent/runs listing.
// ──────────────────────────────────────────────────────────────────────────

model AgentRun {
  id         String    @id @default(cuid())
  userId     String
  threadId   String?
  kind       String    // chat | job | webhook | resume
  model      String
  status     String    // running | completed | failed
  error      String?
  durationMs Int?
  createdAt  DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, status])
}


// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Artifacts (durable deliverables produced by the agent)
// ─────────────────────────────────────────────────────────────────────────
// Study guides, cheat sheets, CSV/JSON datasets, charts, generated images.
// Text content is stored inline; binaries (images) reference a public URL.
// Registered by the create_artifact / generate_document tools and listed
// via /api/medq-agent/artifacts.

model AgentArtifact {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  kind      String   // markdown | html | csv | json | chart | image | document
  mimeType  String   @default("text/plain")
  sizeBytes Int      @default(0)
  content   String?  // inline text content (markdown/html/csv/json)
  url       String?  // public URL for binary artifacts (images)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — HITL approvals (human-in-the-loop tool gates)
// ─────────────────────────────────────────────────────────────────────────
// When a gated tool call (code execution, memory deletion) interrupts the
// agent graph, one row per requested action is persisted here. The row is
// the join entity between the SSE interrupt event, the approval card UI and
// the graph resume (POST /api/agent/approvals → Command resume). Ported
// from all three reference platforms' Approval models.

model AgentApproval {
  id          String    @id @default(cuid())
  userId      String
  threadId    String
  toolName    String
  capability  String    // capability key from permissions.ts (e.g. code.execute)
  argsJson    String    @default("{}")
  description String?
  status      String    @default("pending") // pending | approved | rejected | superseded
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, status])
  @@index([threadId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — per-user permission policy overrides (HITL gate settings)
// ─────────────────────────────────────────────────────────────────────────
// Only capabilities the user has explicitly re-configured get a row; the
// effective policy merges these over DEFAULT_POLICY (permissions.ts).
// Pattern from deep-agent-platform's UserPreference.security overrides.

model AgentPermissionSetting {
  id         String   @id @default(cuid())
  userId     String
  capability String   // capability key from permissions.ts
  effect     String   // allow | ask
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, capability])
}

// ─────────────────────────────────────────────────────────────────────────
// MedQ Agent — Thread & Message persistence (DB-backed conversation history)
// ─────────────────────────────────────────────────────────────────────────
// Ported from the reference "Deep Agent" platform's Thread/Message models.
// The in-process MemorySaver checkpointer (runtime/checkpoints.ts) holds the
// LangGraph state for HITL resume during a single turn; this DB layer gives
// durable cross-session history, the thread-sidebar UI, and message replay
// after a page refresh.
//
// Each thread belongs to a user (or the shared guest). The title is set to
// the first user message, truncated. Messages store role/content/timestamp
// plus optional toolCalls/toolResults JSON (mirrors the reference shape).

model AgentThread {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  AgentThreadMessage[]

  @@index([userId, updatedAt])
}

model AgentThreadMessage {
  id           String   @id @default(cuid())
  threadId     String
  thread       AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role         String   // user | assistant | tool
  content      String   @db.Text
  toolCalls    String?  // JSON: [{id, name, arguments}]
  toolResults  String?  // JSON: [{toolCallId, toolName, content, isError?}]
  metadata     String?  // JSON: {interrupted?: boolean, ...} — interrupted marks an answer persisted mid-generation (user stop / run cap / abort)
  createdAt    DateTime @default(now())

  @@index([threadId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Hermes-port models (compare-and-integrate-2): MCP, scheduler, durable queue,
// usage accounting, audit, agent tasks, messaging integrations, durable
// LangGraph checkpoints, chat feedback. See worklog Task compare-and-integrate-2.
// ═══════════════════════════════════════════════════════════════════════════

// ── MCP subsystem ──
model AgentMcpServer {
  id           String    @id @default(cuid())
  userId       String
  name         String
  transport    String    @default("http") // http | sse | stdio
  url          String?
  command      String?
  argsJson     String?   // JSON string[] for stdio
  headersJson  String?   // JSON {header: value}; secret values stored as encrypted envelopes
  enabled      Boolean   @default(true)
  status       String    @default("unknown") // unknown | ok | error
  lastError    String?
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tools        AgentMcpTool[]

  @@unique([userId, name])
  @@index([userId, enabled])
}

model AgentMcpTool {
  id          String   @id @default(cuid())
  serverId    String
  server      AgentMcpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  schemaJson  String?  // JSON schema, capped at 8000 chars
  enabled     Boolean  @default(true)

  @@unique([serverId, name])
}

// ── Scheduler (cron + one-shot) ──
model AgentScheduledTask {
  id             String    @id @default(cuid())
  userId         String
  name           String
  prompt         String    @db.Text
  cron           String?   // 5-field cron expression (recurring)
  runAt          DateTime? // one-shot time
  timezone       String    @default("UTC")
  status         String    @default("active") // active | paused | completed | failed
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  threadId       String?
  deliverViaJson String?   // JSON [{channel, target}]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([nextRunAt])
}

// ── Durable job queue (lease semantics, retries, cancellation) ──
model AgentJob {
  id              String    @id @default(cuid())
  userId          String
  kind            String    @default("agent.run") // agent.run | task.run | notify.send
  payloadJson     String    @db.Text
  status          String    @default("pending") // pending | leased | done | failed | cancelled
  priority        Int       @default(50)
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  leasedBy        String?
  leaseUntil      DateTime?
  progress        Int       @default(0)
  lastError       String?   @db.Text
  cancelRequested Boolean   @default(false)
  availableAt     DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  scheduledTaskId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  events          AgentJobEvent[]

  @@index([status, availableAt, priority])
  @@index([userId, createdAt])
}

model AgentJobEvent {
  id          String   @id @default(cuid())
  jobId       String
  job         AgentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seq         Int      @default(0)
  type        String   // progress | text | tool_call | tool_result | subagent | done | error | notice
  payloadJson String   @db.Text
  createdAt   DateTime @default(now())

  @@index([jobId, seq])
}

// ── Usage / cost accounting (agent LLM calls) ──
model AgentUsage {
  id           String   @id @default(cuid())
  userId       String?
  model        String
  provider     String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  latencyMs    Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Audit log (agent actions) ──
model AgentAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // tool.execute | approval.request | schedule.create | ...
  target     String?
  detailJson String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ── Agent-managed tasks (todo list the agent can create/update) ──
model AgentTask {
  id        String    @id @default(cuid())
  userId    String
  title     String
  detail    String?
  status    String    @default("pending") // pending | in_progress | done | blocked
  priority  String    @default("medium")  // low | medium | high
  source    String    @default("agent")   // agent | user
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, status])
}

// ── Messaging integrations (telegram/slack/discord/email; dry-run default) ──
model AgentIntegration {
  id         String   @id @default(cuid())
  userId     String
  channel    String   // telegram | slack | discord | email
  configJson String   @db.Text // secret-ish fields stored as encrypted envelopes
  enabled    Boolean  @default(true)
  status     String   @default("unverified")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, channel])
}

// ── Durable LangGraph checkpoints (HITL resume survives restarts) ──
model LgCheckpoint {
  id                 String  @id @default(cuid())
  threadId           String
  checkpointNs       String  @default("")
  checkpointId       String
  parentCheckpointId String?
  type               String?
  checkpoint         String  @db.Text // base64 serde payload
  metadata           String? @db.Text // base64 serde payload

  @@unique([threadId, checkpointNs, checkpointId])
}

model LgWrite {
  id           String  @id @default(cuid())
  threadId     String
  checkpointNs String  @default("")
  checkpointId String
  taskId       String
  idx          Int
  channel      String
  type         String?
  value        String? @db.Text // base64 serde payload

  @@unique([threadId, checkpointNs, checkpointId, taskId, idx])
}

// ── Chat message feedback (fixes dead /api/agent/feedback/v2 endpoint) ──
model AgentFeedback {
  id        String   @id @default(cuid())
  userId    String?
  threadId  String?
  messageId String?
  rating    String   // up | down
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ── AI question-extraction jobs (Question Bank import) ──
// Mirrors the KnowledgeSource pattern: the POST creates a PENDING row and
// returns immediately; processing runs fire-and-continue in the background.
// Because state lives in the DB (not memory), a job survives server restarts
// (a stale "processing" row is auto-resumed on the next poll) and the client
// can close the page and resume the finished/running job later.
model ImportExtraction {
  id            String    @id @default(cuid())
  userId        String
  fileName      String    @default("pasted text")
  status        String    @default("pending") // pending | processing | done | error
  error         String?
  text          String    // source text (kept for resume/retry, capped at 1.5M chars)
  maxQuestions  Int       @default(2000)
  questionsJson String?   // result array (null until done)
  rawCount      Int?
  droppedChunks Int?
  progressDone  Int       @default(0)
  progressTotal Int       @default(0)
  // ── Embedded images that need server-side VLM processing ──
  // Populated when a file (PPTX slide images, DOCX word/media/*, PDF
  // image-bearing pages, or a standalone image/audio file) carries visual
  // content the text layer doesn't capture. JSON array of
  // { dataUrl, caption }. The runJob VLM pass OCRs each, extracts any
  // questions present in the image, and prepends that text to the chunk
  // plan so the text-extraction LLM sees image-grounded context.
  imagesJson    String?
  // ── Resumable multi-pass extraction ──
  // Per-chunk results persisted AS THEY COMPLETE (JSON array parallel to
  // chunkText(text) output: each entry is the parsed questions array for
  // that chunk, or null while the chunk is still pending). A PAUSED job
  // (rate-limited / deadline / restart) resumes from these — completed
  // chunks are NEVER re-extracted and never lost.
  chunkResults  String?
  // Number of extraction passes consumed so far (a pass = one full sweep
  // over the still-pending chunks; PAUSE increments and a later poll may
  // start the next pass, up to MAX_PASSES before honest settlement).
  passCount     Int       @default(0)
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
}

/// Batch AI explanation generator job — same resumable architecture as
/// ImportExtraction: the target question id list is FROZEN at creation,
/// batches are deterministic slices, per-batch results are persisted as
/// they complete, and a rate-limited/deadline-hit job PAUSES (status stays
/// processing, no heartbeat) instead of losing progress — the next poll
/// fast-resumes it into a new pass.
model ExplanationJob {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("pending") // pending | processing | done | error
  error         String?
  // missing = whole-bank questions without an explanation; selected = the
  // frozen questionIds list below (with overwrite, also regenerates).
  scope         String    @default("missing")
  overwrite     Boolean   @default(false)
  questionIds   String    @default("[]") // JSON: frozen target id list
  total         Int       @default(0)
  written       Int?      // settled from the live DB, never from counters
  failed        Int?
  progressDone  Int       @default(0)
  progressTotal Int       @default(0)
  passCount     Int       @default(0)
  // JSON array parallel to the batch plan: {explained: string[]} for a
  // settled batch, null for a still-pending one.
  chunkResults  String?
  metaJson      String?   // JSON: {primaryDead?, primaryFailures?}
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
}

// Retained legacy room mapping from the retired LiveKit integration. No
// active application route reads or writes this table.
model LiveKitRoomMap {
  id        String   @id @default(cuid())
  roomName  String   @unique // LiveKit room name (sanitized)
  chatRoomId String  // original MedQ chat room id (pre-sanitization)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatRoomId])
}

// ── OSCE voice trainer sessions ──
// One row per standardized-patient encounter: the scenario persona (hidden
// profile included), the full turn-by-turn transcript, and the LLM debrief
// (coverage checklist, empathy, red flags, SOAP note, score).
model OsceSession {
  id          String    @id @default(cuid())
  userId      String
  scenario    String    @default("{}")  // JSON: { title, system, persona, hiddenProfile, checklist }
  transcript  String    @default("[]")  // JSON: [{ role: 'student'|'patient', text, ts }]
  result      String?   // JSON: { score, coverage, missed, empathy, redFlags, soapNote } — set on debrief
  status      String    @default("active") // active | completed
  durationSec Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
