// ── Chat System (Telegram-style) ──

model ChatRoom {
  id          String   @id @default(cuid())
  type        String   @default("direct")  // direct, group
  name        String   @default("")        // group name (empty for direct)
  avatar      String   @default("")        // group avatar emoji/icon
  description String   @default("")        // group description
  pinnedMessageIds String @default("[]")  // JSON array of pinned message IDs
  createdBy   String   @default("")        // creator user ID
  lastMessageAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  ChatRoomMember[]
  messages ChatMessage[]
}

model ChatRoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("member") // member, admin
  lastReadAt DateTime @default(now())
  joinedAt DateTime @default(now())
  isMuted  Boolean  @default(false)     // muted notifications
  isPinned Boolean  @default(false)     // pinned chat in sidebar
  pinOrder Int?     // order of pinned chats (lower = higher in list)

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String   @default("")
  type      String   @default("text")  // text, image, system, challenge_invite, file
  metadata  String   @default("{}")    // JSON: attachments, reactions, replyTo, etc.
  isPinned  Boolean  @default(false)   // pinned messages
  isDeleted Boolean  @default(false)   // soft delete
  replyToId String?                    // reply reference
  editedAt  DateTime?
  createdAt DateTime @default(now())

  room    ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender  User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("MessageReplies")

  @@index([roomId, isDeleted, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

// ── University/Year Groups ──

model Group {
  id          String   @id @default(cuid())
  name        String   @default("")
  description String   @default("")
  avatar      String   @default("🎓")     // emoji avatar
  type        String   @default("university") // university, year, study_group, specialty, general
  university  String   @default("")        // university name
  year        String   @default("")        // graduation year or academic year
  specialty   String   @default("")        // medical specialty
  isPublic    Boolean  @default(true)
  inviteCode  String   @default("")        // unique invite code for private groups
  chatRoomId  String?  @unique             // optional: 1:1 link to a ChatRoom (so chat-room group chats can have study features)
  memberCount Int      @default(0)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  posts       Post[]
  lectures    GroupLecture[]
  questions   GroupQuestion[]
  quizAttempts GroupQuizAttempt[]
  adPolls     GroupAdPoll[]
