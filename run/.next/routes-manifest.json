{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/",
      "missing": [
        {
          "type": "query",
          "key": "tab"
        }
      ],
      "destination": "/home",
      "statusCode": 307,
      "regex": "^(?!/_next)/(?:/)?$"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tab",
          "value": "dashboard"
        }
      ],
      "destination": "/home",
      "statusCode": 307,
      "regex": "^(?!/_next)/(?:/)?$"
    },
    {
      "source": "/exam/take",
      "destination": "/?tab=take-exam",
      "statusCode": 307,
      "regex": "^(?!/_next)/exam/take(?:/)?$"
    },
    {
      "source": "/exam-sim/voice",
      "destination": "/exam-sim",
      "statusCode": 307,
      "regex": "^(?!/_next)/exam-sim/voice(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/bank/:nxtPid",
        "destination": "/(.)bank/:nxtPid",
        "has": [
          {
            "type": "header",
            "key": "next-url",
            "value": "/.*"
          }
        ],
        "regex": "^/bank(?:/([^/]+?))(?:/)?$"
      },
      {
        "source": "/forgot-password",
        "destination": "/landing/(..)forgot-password",
