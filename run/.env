# DATABASE_URL=file:/home/z/my-project/db/custom.db
# .env.local — overrides .env, persists across platform recycles.
# The platform boot script rewrites /tmp/my-project/.env with a stale SQLite
# DATABASE_URL on every restart, shadowing the real PostgreSQL connection.
# .env.local is loaded AFTER .env by Next.js + dotenv, so this wins.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/nextapp?schema=public"
NEXTAUTH_SECRET="4c2f347f88732e5dcbd1353466c46fdf6b6b3b7543aa8beca8ef28734e8cc047"
AUTH_TRUST_HOST=true
MEDQ_AGENT_BASE_URL=http://127.0.0.1:3000/v1
MEDQ_AGENT_API_KEY=freellmapi-53bff103f9070b09be7ba2bd2133ff199c84e79fb38a66e3
MEDQ_AGENT_MODEL=gpt-4.1
DEFAULT_MODEL=openai:gpt-4.1
OPENAI_API_KEY=freellmapi-53bff103f9070b09be7ba2bd2133ff199c84e79fb38a66e3
OPENAI_BASE_URL=http://127.0.0.1:3000/v1

